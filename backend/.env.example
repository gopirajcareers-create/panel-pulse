## Backend Server Configuration

# Listen port
PORT=3000

# NODE_ENV: set to 'production' in production deployments
NODE_ENV=production

# MongoDB Connection (Atlas) - replace with your production connection string
MONGODB_URI=mongodb://<username>:<password>@cluster.mongodb.net:27017/dbname?authSource=admin&replicaSet=replicaset&ssl=true
MONGODB_DB=panel_db

# Frontend URL (for CORS)
FRONTEND_URL=https://panel-pulse.vercel.app

# LLM Provider Configuration (priority: Ollama → GROQ → Mistral)
# Option 1: Local Ollama (data stays on-prem, recommended for production)
OLLAMA_BASE_URL=http://10.10.160.51:11434
OLLAMA_MODEL_NAME=qwen3:latest

# Option 2: Cloud API Keys (fallback or standalone)
MISTRAL_API_KEY=<your_mistral_api_key>
GROQ_API_KEY=<your_groq_api_key>

# LLM Model Names (optional, defaults shown)
# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# MISTRAL_MODEL_NAME=mistral-large-latest

# Optional: Custom Port for API
# API_PORT=3000

# Development example (uncomment if running locally):
# NODE_ENV=development
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# MONGODB_DB=pp_db
